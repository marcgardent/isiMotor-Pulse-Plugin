// isiMotor RawUDP - CompactScoring (outbound, packet type 2).
// Published on its own ZeroMQ PUB port (TcpBasePort + 2); the message on
// that port IS this FlatBuffer, with no outer framing/header.
namespace isimotor.fbs;

table CompactScoring {
  track_name: string;
  session: int32;          // 0=testday, 1-4=practice, 5-8=qual, 9=warmup, 10-13=race
  current_et: double;
  total_lap_dist: double;
  max_laps: int32;
  in_realtime: bool;
  total_laps: int16;
  sector: int8;             // 0=Sector 3, 1=Sector 1, 2=Sector 2
  in_garage_stall: bool;
  count_lap_flag: ubyte;    // 0=invalid, 1=lap count only, 2=valid lap & time
  cur_sector1: double;
  cur_sector2: double;
  last_sector1: double;
  last_sector2: double;
  last_lap_time: double;
  best_sector1: double;
  best_sector2: double;
  best_lap_time: double;
}

root_type CompactScoring;
